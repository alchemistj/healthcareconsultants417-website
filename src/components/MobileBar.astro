---
import global from "@/data/copy/_global.json";
import { getCity, contactPath } from "@/data/cityConfig";
import PhoneLink from "./PhoneLink.astro";

interface Props {
  citySlug?: string;
  /** Overrides the CTA target (for example a booking embed anchor). */
  ctaHref?: string;
}

const city = getCity(Astro.props.citySlug);
const ctaHref = Astro.props.ctaHref ?? contactPath(city);
---

<!-- Rule 6: phones only (below md). Call label, not digits (Rule 7.2). -->
<div class="mobile-bar" role="region" aria-label={global.a11y.mobileBar}>
  <PhoneLink class="btn btn-light" label={global.call.label} citySlug={city.slug} />
  <a class="btn btn-primary" href={ctaHref}>{global.cta.label}</a>
</div>

<style>
  .mobile-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    display: flex;
    gap: 10px;
    padding: 8px var(--content-pad) calc(8px + env(safe-area-inset-bottom, 0px));
    height: calc(var(--bar-h) + env(safe-area-inset-bottom, 0px));
    background: var(--color-dark);
  }

  .mobile-bar :global(.btn) {
    flex: 1;
  }

  @media (min-width: 768px) {
    .mobile-bar {
      display: none;
    }
  }
</style>
