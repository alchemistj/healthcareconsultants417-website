---
interface Props {
  quote: string;
  /** First name and last initial, for example "Jane D." */
  name: string;
  /** Only when known for sure. */
  city?: string;
}

const { quote, name, city } = Astro.props;
---

<section class="review-band">
  <div class="container">
    <figure>
      <blockquote><p>{quote}</p></blockquote>
      <figcaption>{name}{city ? `, ${city}` : ""}</figcaption>
    </figure>
  </div>
</section>

<style>
  .review-band {
    padding-block: 48px;
    border-block: 1px solid color-mix(in srgb, var(--color-dark) 14%, transparent);
  }

  figure {
    margin: 0;
    padding-left: 20px;
    border-left: 4px solid var(--color-accent);
  }

  blockquote {
    margin: 0;
    font-size: 1.2rem;
  }

  figcaption {
    margin-top: 12px;
    font-weight: 700;
  }
</style>
