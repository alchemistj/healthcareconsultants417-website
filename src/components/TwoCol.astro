---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  heading: string;
  paragraphs?: string[];
  /** Photo from src/assets (ImageMetadata). Same photo and order as the old page. */
  image: ImageMetadata;
  alt: string;
  /** Which side the photo sits on at desktop. Alternate: right, left, right... */
  side: "right" | "left";
  /** CSS object-position for the crop (point the subject toward the text). */
  objectPosition?: string;
}

const { heading, paragraphs = [], image, alt, side, objectPosition = "50% 0%" } = Astro.props;

// Sized to the column: ~42% of the 900px content width, times 1.15.
const displayWidth = 440;
const displayHeight = Math.round((displayWidth * image.height) / image.width);
---

<section class="section two-col" data-side={side}>
  <div class="container grid">
    <div class="text">
      <h2>{heading}</h2>
      {paragraphs.map((p) => <p>{p}</p>)}
      <slot />
    </div>
    <div class="photo">
      <Image
        src={image}
        alt={alt}
        width={displayWidth}
        height={displayHeight}
        format="webp"
        loading="lazy"
        decoding="async"
        style={`object-position: ${objectPosition};`}
      />
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 24px;
  }

  /* Mobile: text first, then the photo at a modest 4:3. */
  .photo {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 768px) {
    .grid {
      grid-template-columns: 58fr 42fr;
      gap: 36px;
      align-items: stretch;
    }

    /* Photo matches the text column's height: no empty space either side. */
    .photo {
      aspect-ratio: auto;
      min-height: 100%;
    }

    [data-side="left"] .grid {
      grid-template-columns: 42fr 58fr;
    }

    [data-side="left"] .text {
      order: 2;
    }

    [data-side="left"] .photo {
      order: 1;
    }
  }
</style>
